/*
 * nRF52840 DK **only** — **main.c** full app (prj_full_vitaband.conf). Same logical sensors as
 * app_vitaband_base, but pinmux matches the DK + Arduino headers.
 *
 * **Do not use this file for the VitaBand PCB** — flash **app_vitaband_base.overlay** instead.
 *
 *   MAX86140 on **SPI3** (Arduino D11–D13, CS D10) — same as app_ble_hr_body_dk.overlay
 *   TMP117 + SHT3x on **I2C0** (P0.26 / P0.27 — Arduino A4/A5)
 *
 * Use this instead of app_vitaband_base.overlay when you see vitals stuck at body_raw=-99 / amb=-99
 * and boot logs showed MAX86140=FAIL (VitaBand overlay maps SPI to the wrong pins for the DK).
 *
 * If TMP117 NACKs, try pin swap:
 *   -DDTC_OVERLAY_FILE="app_main_full_dk.overlay;app_tmp117_i2c_dkswap.overlay"
 *
 * SHT3x I2C address 0x45 (ADDR→VDD). Change to 0x44 in-tree if your part uses ADDR→GND.
 *
 * west build -b nrf52840dk/nrf52840 -- \
 *   -DCONF_FILE=prj_full_vitaband.conf \
 *   -DDTC_OVERLAY_FILE=app_main_full_dk.overlay
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/spi/spi.h>

/ {
	chosen {
		zephyr,console = &rtt0;
		zephyr,bt-mon-uart = &rtt0;
		zephyr,bt-c2h-uart = &rtt0;
		/delete-property/ zephyr,shell-uart;
		/delete-property/ zephyr,uart-mcumgr;
	};

	rtt0: rtt_chan0 {
		compatible = "segger,rtt-uart";
		status = "okay";
	};

	leds {
		status = "disabled";
		led0: led_0 { status = "disabled"; gpios = <&gpio0 2 GPIO_ACTIVE_LOW>; };
		led1: led_1 { status = "disabled"; gpios = <&gpio0 3 GPIO_ACTIVE_LOW>; };
		led3: led_3 { status = "disabled"; gpios = <&gpio0 7 GPIO_ACTIVE_LOW>; };
	};

	pwmleds {
		status = "disabled";
		pwm_led0: pwm_led_0 { status = "disabled"; };
	};

	aliases {
		emergency-button = &emergency_button;
		buzzer = &pwm_buzzer_led;
		motor-en = &motor_en_line;
	};

	motor_gpios {
		compatible = "gpio-leds";
		motor_en_line: motor_en_line {
			gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
			label = "motor-en";
		};
	};

	buttons {
		compatible = "gpio-keys";
		emergency_button: emergency_button {
			gpios = <&gpio0 17 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Emergency Button";
		};
	};

	pwm_buzzer_group {
		compatible = "pwm-leds";
		pwm_buzzer_led: pwm_buzzer_led {
			pwms = <&pwm0 0 250000 PWM_POLARITY_NORMAL>;
			label = "buzzer-pwm";
		};
	};
};

&uart0 {
	status = "disabled";
};

&adc {
	status = "disabled";
};

/* VitaBand PCB uses TWIM1 here; on DK we use TWIM0 for the same P0.26/P0.27 header pins. */
&i2c1 {
	status = "disabled";
};

&spi0 {
	status = "disabled";
};

&spi1 {
	status = "disabled";
};

&spi2 {
	status = "disabled";
};

&pinctrl {
	i2c0_full_dk: i2c0_full_dk {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 0, 26)>,
				<NRF_PSEL(TWIM_SDA, 0, 27)>;
			bias-pull-up;
		};
	};

	i2c0_full_dk_sleep: i2c0_full_dk_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 0, 26)>,
				<NRF_PSEL(TWIM_SDA, 0, 27)>;
			low-power-enable;
		};
	};

	pwm0_buzzer_dk: pwm0_buzzer_dk {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 5)>;
			nordic,drive-mode = <NRF_DRIVE_H0H1>;
		};
	};

	pwm0_buzzer_dk_sleep: pwm0_buzzer_dk_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 5)>;
			low-power-enable;
		};
	};
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_buzzer_dk>;
	pinctrl-1 = <&pwm0_buzzer_dk_sleep>;
	pinctrl-names = "default", "sleep";
};

&i2c0 {
	status = "okay";
	compatible = "nordic,nrf-twim";
	pinctrl-0 = <&i2c0_full_dk>;
	pinctrl-1 = <&i2c0_full_dk_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <100000>;

	tmp117: tmp117@49 {
		compatible = "ti,tmp117";
		reg = <0x49>;
		status = "okay";
	};

	sht3xdis: sht3xdis@45 {
		compatible = "sensirion,sht3xd";
		reg = <0x45>;
		status = "okay";
	};
};

/* Board BSP enables SPI3 on Arduino; add MAX86140 node (same as app_ble_hr_body_dk.overlay). */
&spi3 {
	max86140: maxim_max86140@0 {
		compatible = "maxim,max86140";
		reg = <0>;
		spi-max-frequency = <8000000>;
		frame-format = <SPI_FRAME_FORMAT_MOTOROLA>;
	};
};

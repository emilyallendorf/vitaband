#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/adc/adc.h>

/ {
    aliases {
        /* These names must match what you use in DT_ALIAS() */
        vibration-motor = &vibration_motor; 
        buzzer = &buzzer;
        led0 = &led0;
    };

    leds {
        compatible = "gpio-leds";
        led0: led_0 {
            gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
            label = "Alert LED";
        };
    };

    pwmleds {
        compatible = "pwm-leds";
        vibration_motor: vibration_motor {
            pwms = <&pwm0 0 1000 PWM_POLARITY_NORMAL>;
        };
        buzzer: buzzer {
            pwms = <&pwm0 1 250 PWM_POLARITY_NORMAL>;
        };
    };
};



&i2c0 {
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_default>;
    pinctrl-names = "default", "sleep";

    tmp117: tmp117@48 {
        compatible = "ti,tmp117";
        reg = <0x48>;
        label = "TMP117";
    };

    sht3xdis: sht3x@44 {
        compatible = "sensirion,sht3xd"; /* Standard Zephyr compatible for SHT3x */
        reg = <0x44>; /* Check if your addr is 0x44 or 0x45 */
    };
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_default>;
    pinctrl-names = "default", "sleep";
};

&spi1 {
    status = "okay";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 25 GPIO_ACTIVE_LOW>;

    max86140: max86140@0 {
        compatible = "maxim,max86140";
        reg = <0>;
        
        spi-max-frequency = <1000000>;
        duplex = <0>;           /* 0 = Full Duplex */
        frame-format = <0>;     /* 0 = Motorola (Standard) */
    };
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 31)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 30)>,
                    <NRF_PSEL(SPIM_MISO, 0, 29)>;
        };
    };

    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 27)>,
                    <NRF_PSEL(TWIM_SCL, 0, 26)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 31)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 30)>,
                    <NRF_PSEL(SPIM_MISO, 0, 29)>;
            low-power-enable;
        };
    };

    pwm0_default: pwm0_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 7)>,
                    <NRF_PSEL(PWM_OUT1, 0, 8)>;
        };
    };
};

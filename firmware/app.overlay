&i2c0 {
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_STANDARD>; // 100kHz is safest for mixed sensors

    /* Existing Heart Rate Sensor */
    max30102: max30102@57 {
        compatible = "i2c-device";
        reg = <0x57>;
    };

    /* High Precision Skin Temp Sensor */
    tmp117: tmp117@48 {
        compatible = "i2c-device";
        reg = <0x48>;
    };

    /* Ambient Temp & Humidity Sensor */
    sht3xdis: sht3xdis@44 {
        compatible = "i2c-device";
        reg = <0x44>;
    };

    &adc {
    #address-cells = <1>;
    #size-cells = <0>;
    status = "okay";
    
    channel@1 {
        reg = <1>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN1>;  /* P0.03 */
        zephyr,resolution = <12>;
    };
};
};

/*
 * Device Tree Overlay for Wearable Health Monitor
 * nRF52840 Configuration
 */

/ {
    /* ================================================================ */
    /* ALIASES                                                          */
    /* ================================================================ */
    
    aliases {
        /* Haptic outputs */
        led0 = &led0;
        vibration-motor = &vibration_motor;
        buzzer = &buzzer;
        
        /* Optional: USB detect for charging status */
        /* Uncomment if your PCB has USB detect pin */
        /* usb-detect = &usb_detect_pin; */
    };
    
    /* ================================================================ */
    /* LED CONFIGURATION                                                */
    /* ================================================================ */
    
    leds {
        compatible = "gpio-leds";
        
        led0: led_0 {
            /* TODO: Ask partner which GPIO pin is used for LED */
            /* Example: P0.06 */
            gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
            label = "Alert LED";
        };
    };
    
    /* ================================================================ */
    /* PWM OUTPUTS (Vibration Motor & Buzzer)                          */
    /* ================================================================ */
    
    pwmleds {
        compatible = "pwm-leds";
        
        vibration_motor: vibration_motor {
            /* PWM channel 0 for vibration motor */
            /* TODO: Ask partner which pin */
            /* Example: P0.07 on PWM0 channel 0 */
            pwms = <&pwm0 0 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
            label = "Vibration Motor";
        };
        
        buzzer: buzzer {
            /* PWM channel 1 for buzzer */
            /* TODO: Ask partner which pin */
            /* Example: P0.08 on PWM0 channel 1 */
            pwms = <&pwm0 1 PWM_USEC(250) PWM_POLARITY_NORMAL>;
            label = "Piezo Buzzer";
        };
    };
    
    /* ================================================================ */
    /* BATTERY VOLTAGE MONITORING                                       */
    /* ================================================================ */
    
    vbatt {
        compatible = "voltage-divider";
        io-channels = <&adc 1>;
        
        /* TODO: Ask sharia about voltage divider values */
        /* If R1=100k, R2=100k: output-ohms=100000, full-ohms=200000 */
        /* If no voltage divider: output-ohms=100000, full-ohms=100000 */
        output-ohms = <100000>;  /* R2 */
        full-ohms = <200000>;    /* R1 + R2 */
    };
    
    /* ================================================================ */
    /* OPTIONAL: USB DETECT PIN                                         */
    /* ================================================================ */
    
    /* Uncomment if your PCB has USB detect functionality */
    /*
    usb_detect_pin: usb_detect {
        compatible = "gpio-keys";
        usb_detect {
            gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
            label = "USB Detect";
        };
    };
    */
};

/* ==================================================================== */
/* I2C CONFIGURATION (for Heart Rate & Temperature Sensors)            */
/* ==================================================================== */

/* Configure I2C0 pins */
&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            /* TODO: Ask partner which pins for I2C */
            /* Common: P0.26 = SCL, P0.27 = SDA */
            psels = <NRF_PSEL(TWIM_SDA, 0, 27)>,
                    <NRF_PSEL(TWIM_SCL, 0, 26)>;
        };
    };
    
    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 27)>,
                    <NRF_PSEL(TWIM_SCL, 0, 26)>;
            low-power-enable;
        };
    };
};

/* Enable and configure I2C0 */
&i2c0 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_STANDARD>; /* 100 kHz */
    
    /* ============================================================ */
    /* MAX30102 Heart Rate Sensor                                   */
    /* ============================================================ */
    
    max30102: max30102@57 {
        compatible = "maxim,max30102";
        reg = <0x57>;  /* I2C address: 0x57 */
        label = "MAX30102";
        /* Interrupt pin (optional) */
        /* int-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>; */
    };
    
    /* ============================================================ */
    /* TMP117 Temperature Sensor                                    */
    /* ============================================================ */
    
    tmp117: tmp117@48 {
        compatible = "ti,tmp117";
        reg = <0x48>;  /* I2C address: 0x48 (default) */
        label = "TMP117";
    };
};

/* ==================================================================== */
/* ADC CONFIGURATION (for Battery Voltage Monitoring)                  */
/* ==================================================================== */

&adc {
    #address-cells = <1>;
    #size-cells = <0>;
    status = "okay";
    
    /* Channel 1 for battery voltage */
    channel@1 {
        reg = <1>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        
        /* TODO: Ask partner which ADC pin */
        /* Common: AIN1 = P0.03 */
        zephyr,input-positive = <NRF_SAADC_AIN1>;
        zephyr,resolution = <12>;
    };
};

/* ==================================================================== */
/* PWM CONFIGURATION (for Vibration Motor & Buzzer)                    */
/* ==================================================================== */

/* Configure PWM0 pins */
&pinctrl {
    pwm0_default: pwm0_default {
        group1 {
            /* TODO: Ask sharia which pins for PWM */
            /* Example: P0.07 for vibration, P0.08 for buzzer */
            psels = <NRF_PSEL(PWM_OUT0, 0, 7)>,   /* Vibration motor */
                    <NRF_PSEL(PWM_OUT1, 0, 8)>;   /* Buzzer */
        };
    };
    
    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 7)>,
                    <NRF_PSEL(PWM_OUT1, 0, 8)>;
            low-power-enable;
        };
    };
};

/* Enable and configure PWM0 */
&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};
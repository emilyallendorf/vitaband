/*
 * VitaBand — application overlay (do NOT #include the SoC .dtsi here; the board
 * target already provides it. Including nrf52840_qiaaa.dtsi breaks the merged
 * tree and causes errors like __device_dts_ord_N undeclared in C sources.)
 *
 * Pin assignment — MDBT50Q-1MV2 (nRF52840):
 *   MOTOR_EN  P0.04 (GPIO)   BUZZER_EN P0.05 (pwm0 OUT0)   HR_INT P0.06   BUTTON P0.17
 *   I2C SCL P0.26 / SDA P0.27   SPI as in &spi1
 *
 * UART0: TX/RX moved off P0.06 (HR_INT). On nRF52840 DK, P0.11 is Button 1 —
 * do not use RX on P0.11 if you need sw0 on the DK.
 */

#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/gpio/nordic-nrf-gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
    aliases {
        /* haptics.c uses led0 only if status "okay"; stub keeps P0.06 free (HR_INT). */
        led0 = &vitaband_led0_placeholder;
        vibration-motor  = &vibration_motor;
        /* PWM consumer node (pwms) — not gpio-leds; haptics.c uses pwm_dt_spec */
        buzzer           = &buzzer_en_pwm;
        emergency-button = &emergency_button;
    };

    leds {
        vitaband_led0_placeholder: vitaband_led0_placeholder {
            status = "disabled";
            gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
            label = "No discrete LED (P0.06 is HR_INT)";
        };
    };

    haptic_gpios {
        compatible = "gpio-leds";
        vibration_motor: vibration_motor {
            gpios = <&gpio0 4 (GPIO_PUSH_PULL | GPIO_ACTIVE_HIGH | NRF_GPIO_DRIVE_H0H1)>;
            label = "MOTOR_EN";
        };
    };

    /* Piezo buzzer enable: hardware PWM on P0.05 (runtime frequency via pwm_set_dt). */
    buzzer_en_pwm: buzzer_en_pwm {
        pwms = <&pwm0 0 PWM_NSEC(250000) PWM_POLARITY_NORMAL>;
        label = "BUZZER_EN";
    };

    /* DK on-board pwm-leds also uses pwm0 ch0; disable when BUZZER uses OUT0 @ P0.05 */
    pwmleds {
        status = "disabled";
    };

    buttons {
        compatible = "gpio-keys";
        emergency_button: emergency_button {
            gpios = <&gpio0 17 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Emergency Button";
        };
    };
};

/* Free P0.04/P0.05 from ADC when used for haptics (motor GPIO + buzzer PWM) */
&adc {
    status = "disabled";
};

&i2c0 {
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    tmp117: tmp117@48 {
        compatible = "ti,tmp117";
        reg = <0x48>;
    };

    sht3xdis: sht3x@44 {
        compatible = "sensirion,sht3xd";
        reg = <0x44>;
    };
};

&spi1 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;

    max86140: max86140@0 {
        compatible = "maxim,max86140";
        reg = <0>;
        spi-max-frequency = <4000000>;
    };
};

&pinctrl {
    uart0_default: uart0_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 8)>;
        };
        group2 {
            psels = <NRF_PSEL(UART_RX, 0, 11)>;
            bias-pull-up;
        };
    };

    uart0_sleep: uart0_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 8)>,
                    <NRF_PSEL(UART_RX, 0, 11)>;
            low-power-enable;
        };
    };

    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SCL, 0, 26)>,
                    <NRF_PSEL(TWIM_SDA, 0, 27)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SCL, 0, 26)>,
                    <NRF_PSEL(TWIM_SDA, 0, 27)>;
            low-power-enable;
        };
    };

    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK,  0, 15)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 16)>,
                    <NRF_PSEL(SPIM_MISO, 0, 13)>;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK,  0, 15)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 16)>,
                    <NRF_PSEL(SPIM_MISO, 0, 13)>;
            low-power-enable;
        };
    };

    pwm0_buzzer: pwm0_buzzer {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 5)>;
            nordic,drive-mode = <NRF_DRIVE_H0H1>;
        };
    };

    pwm0_buzzer_sleep: pwm0_buzzer_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 5)>;
            low-power-enable;
        };
    };
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_buzzer>;
    pinctrl-1 = <&pwm0_buzzer_sleep>;
    pinctrl-names = "default", "sleep";
};

/*
 * VitaBand PCB — **full application base** (default main.c):
 *   MAX86140 on SPIM0 + TMP117 + SHT3x-DIS on **TWIM1** (P0.26 SCL, P0.27 SDA).
 * TWIM0 shares the SPIM0 peripheral — keep i2c0 disabled when SPI0 is used.
 *
 * **nRF52840 DK:** do **not** use this file — SPI/I2C pinmux is for the VitaBand board. Use
 * **app_main_full_dk.overlay** with prj_full_vitaband.conf (SPI3 + I2C0 on Arduino headers).
 *
 * SHT3x I²C address **0x45** (ADDR pin → VDD). Use **0x44** if ADDR is tied to GND
 * (change reg = <0x44> on the sht3xdis node).
 *
 * MOTOR_EN on **P0.04** (haptics.c DT_ALIAS(motor_en)). nRF52840 DK on-board LEDs use
 * P0.13–P0.16 — no GPIO clash with P0.04.
 *
 * Console: Segger RTT only (`rtt0`), match prj_full_vitaband.conf / prj_vitaband_sensors.conf
 * (CONFIG_RTT_CONSOLE=y, CONFIG_UART_CONSOLE=n, CONFIG_SERIAL=n). Logs use the **same J-Link USB**
 * as flash/debug; unplugging that USB stops **new** bytes from reaching the PC (scrollback may look
 * like output continues). Physical uart0 disabled — not the DK virtual COM port unless you rebuild
 * with UART console + uart0 enabled.
 *
 * Example:
 *   west build -b nrf52840dk/nrf52840 firmware -- \
 *     -DEXTRA_CONF_FILE=prj_vitaband_sensors.conf \
 *     -DDTC_OVERLAY_FILE=app_vitaband_base.overlay
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/spi/spi.h>

/ {
	chosen {
		zephyr,console = &rtt0;
		zephyr,bt-mon-uart = &rtt0;
		zephyr,bt-c2h-uart = &rtt0;
		/delete-property/ zephyr,shell-uart;
		/delete-property/ zephyr,uart-mcumgr;
	};

	/* Segger RTT as a UART device — printk/LOG go here when CONFIG_UART_CONSOLE=y + SERIAL=y */
	rtt0: rtt_chan0 {
		compatible = "segger,rtt-uart";
		status = "okay";
	};

	/*
	 * nrf52840dk merges gpio-leds on P0.13–P0.16 — same pins as SPIM0 + CS for MAX86140.
	 * Remap every led_* to harmless pins (same pattern as app_ble_hr_body_vitaband.overlay).
	 * led_2 must leave P0.14 (SPI CS): ble-hr-body maps led_2 → P0.04; we use P0.04 for motor-en,
	 * so park led_2 on P0.28 (assume NC on VitaBand PCB — adjust if your layout uses it).
	 */
	leds {
		status = "disabled";
		led0: led_0 { status = "disabled"; gpios = <&gpio0 2 GPIO_ACTIVE_LOW>; };
		led1: led_1 { status = "disabled"; gpios = <&gpio0 3 GPIO_ACTIVE_LOW>; };
		led2: led_2 { status = "disabled"; gpios = <&gpio0 28 GPIO_ACTIVE_LOW>; };
		led3: led_3 { status = "disabled"; gpios = <&gpio0 7 GPIO_ACTIVE_LOW>; };
	};

	pwmleds {
		status = "disabled";
		pwm_led0: pwm_led_0 { status = "disabled"; };
	};

	aliases {
		emergency-button = &emergency_button;
		buzzer = &pwm_buzzer_led;
		motor-en = &motor_en_line;
	};

	/* gpio-leds: compatible expected by Zephyr; P0.04 = MOTOR_EN (same as main_blinky) */
	motor_gpios {
		compatible = "gpio-leds";
		motor_en_line: motor_en_line {
			gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
			label = "motor-en";
		};
	};

	buttons {
		compatible = "gpio-keys";
		emergency_button: emergency_button {
			gpios = <&gpio0 17 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Emergency Button";
		};
	};

	pwm_buzzer_group {
		compatible = "pwm-leds";
		pwm_buzzer_led: pwm_buzzer_led {
			pwms = <&pwm0 0 250000 PWM_POLARITY_NORMAL>;
			label = "buzzer-pwm";
		};
	};
};

&uart0 {
	status = "disabled";
};

&adc {
	status = "disabled";
};

&i2c0 {
	status = "disabled";
};

&spi1 {
	status = "disabled";
};

&spi2 {
	status = "disabled";
};

&spi3 {
	status = "disabled";
};

&pinctrl {
	spi0_max86140_vb: spi0_max86140_vb {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 15)>,
				<NRF_PSEL(SPIM_MOSI, 0, 16)>;
			nordic,drive-mode = <NRF_DRIVE_H0H1>;
		};
		group2 {
			psels = <NRF_PSEL(SPIM_MISO, 0, 13)>;
		};
	};

	spi0_max86140_vb_sleep: spi0_max86140_vb_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 15)>,
				<NRF_PSEL(SPIM_MOSI, 0, 16)>;
			low-power-enable;
		};
		group2 {
			psels = <NRF_PSEL(SPIM_MISO, 0, 13)>;
			low-power-enable;
		};
	};

	i2c1_vb: i2c1_vb {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 0, 26)>,
				<NRF_PSEL(TWIM_SDA, 0, 27)>;
			bias-pull-up;
		};
	};

	i2c1_vb_sleep: i2c1_vb_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 0, 26)>,
				<NRF_PSEL(TWIM_SDA, 0, 27)>;
			low-power-enable;
		};
	};

	pwm0_buzzer_vb: pwm0_buzzer_vb {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 5)>;
			nordic,drive-mode = <NRF_DRIVE_H0H1>;
		};
	};

	pwm0_buzzer_vb_sleep: pwm0_buzzer_vb_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 5)>;
			low-power-enable;
		};
	};
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_buzzer_vb>;
	pinctrl-1 = <&pwm0_buzzer_vb_sleep>;
	pinctrl-names = "default", "sleep";
};

&spi0 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi0_max86140_vb>;
	pinctrl-1 = <&spi0_max86140_vb_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;

	max86140: maxim_max86140@0 {
		compatible = "maxim,max86140";
		reg = <0>;
		spi-max-frequency = <1000000>;
		frame-format = <SPI_FRAME_FORMAT_MOTOROLA>;
	};
};

&i2c1 {
	status = "okay";
	compatible = "nordic,nrf-twim";
	pinctrl-0 = <&i2c1_vb>;
	pinctrl-1 = <&i2c1_vb_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <100000>;

	tmp117: tmp117@49 {
		compatible = "ti,tmp117";
		reg = <0x49>;
		status = "okay";
	};

	sht3xdis: sht3xdis@45 {
		compatible = "sensirion,sht3xd";
		reg = <0x45>;
		status = "okay";
	};
};

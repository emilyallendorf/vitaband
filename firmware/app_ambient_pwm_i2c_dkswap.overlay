/*
 * nRF52840 DK Arduino header I2C order: SDA=P0.26, SCL=P0.27 (vs VitaBand SCL=26, SDA=27).
 * Append AFTER app_ambient_pwm.overlay when testing ambient on the DK without VitaBand wiring:
 *
 *   west build ... -- -DDTC_OVERLAY_FILE="app_ambient_pwm.overlay;app_ambient_pwm_i2c_dkswap.overlay"
 */

#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

&pinctrl {
	i2c0_ambient: i2c0_ambient {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 0, 27)>,
				<NRF_PSEL(TWIM_SDA, 0, 26)>;
		};
	};

	i2c0_ambient_sleep: i2c0_ambient_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 0, 27)>,
				<NRF_PSEL(TWIM_SDA, 0, 26)>;
			low-power-enable;
		};
	};
};
